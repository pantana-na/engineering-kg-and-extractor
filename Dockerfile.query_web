# ==============================================================================
# Production Container Image for OKF Spanner Graph & Retrieval Workbench UI
# (`okf-query-agent-web` — Separate Cloud Run Service)
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    GOOGLE_GENAI_USE_VERTEXAI=true \
    GEMINI_LOCATION=global \
    GEMINI_MODEL=gemini-3.8-flash \
    APP_MODULE=query_agent.web_server:app

WORKDIR /app

COPY pyproject.toml README.md ./
COPY extracter_agent ./extracter_agent
COPY query_agent ./query_agent
COPY docs ./docs

RUN pip install --upgrade pip && \
    pip install --no-cache-dir . uvicorn fastapi

EXPOSE 8080

CMD ["sh", "-c", "uvicorn query_agent.web_server:app --host 0.0.0.0 --port ${PORT:-8080}"]
