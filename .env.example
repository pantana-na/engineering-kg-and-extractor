# ==============================================================================
# Extracter Agent & Spanner Query Agent Configuration
# Target Project: your-gcp-project-id
# Repository: https://github.com/pantana-na/engineering-kg-and-extractor.git
# Rule 8 Compliance: Single Unified Environment Parameter Management
# ==============================================================================

# ------------------------------------------------------------------------------
# Shared / Core Configuration
# ------------------------------------------------------------------------------
SERVICE_NAME=extracter-agent
QUERY_SERVICE_NAME=okf-query-agent
GIT_REPO_URL=https://github.com/pantana-na/engineering-kg-and-extractor.git
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GEMINI_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash
DEPLOYMENT_TARGET=agent_runtime

# Knowledge Storage & Bundle Destinations
DESTINATION_GCS_BUCKET=your-gcp-project-id-okf-knowledge
DESTINATION_GCS_PREFIX=okf-bundles/chemical-plant
SOURCE_GCS_RAW_PREFIX=reference/raw
OUTPUT_BUNDLE_DIR=build/okf_bundle

# Cloud Spanner Graph-RAG, Vector, Full-Text & Lineage Store
SPANNER_INSTANCE_ID=okf-knowledge-spanner
SPANNER_DATABASE_ID=okf_knowledge_graph
SPANNER_PROCESSING_UNITS=100
EMBEDDING_MODEL=text-embedding-005
DATAPLEX_ENTRY_GROUP_ID=okf_knowledge_assets
DATAPLEX_TAG_TEMPLATE_ID=okf_governance_template

# Local Reference Directories (Immutable source materials)
REFERENCE_RAW_DIR=reference/raw
REFERENCE_WIKI_DIR=reference/wiki

# ------------------------------------------------------------------------------
# Non-Production Environment Configuration (NONPROD_*)
# ------------------------------------------------------------------------------
NONPROD_ENVIRONMENT_NAME=nonprod
NONPROD_PROJECT_ID=your-gcp-project-id
NONPROD_REGION=asia-southeast1
NONPROD_GCS_BUCKET=your-gcp-project-id-okf-knowledge-nonprod
NONPROD_AGENT_RUNTIME_ID=extracter-agent-nonprod
NONPROD_QUERY_AGENT_RUNTIME_ID=okf-query-agent-nonprod
CLOUD_RUN_WEB_SERVICE=extracter-agent-web
CLOUD_RUN_WEB_URL=https://extracter-agent-web-nonprod.a.run.app
QUERY_WEB_SERVICE_NAME=okf-query-agent-web
QUERY_WEB_SERVICE_URL=https://okf-query-agent-web-nonprod.a.run.app
NONPROD_MIN_INSTANCES=0
NONPROD_MAX_INSTANCES=3

# ------------------------------------------------------------------------------
# Production Environment Configuration (PROD_*)
# ------------------------------------------------------------------------------
PROD_ENVIRONMENT_NAME=prod
PROD_PROJECT_ID=your-gcp-project-id
PROD_REGION=asia-southeast1
PROD_GCS_BUCKET=your-gcp-project-id-okf-knowledge-prod
PROD_AGENT_RUNTIME_ID=extracter-agent-prod
PROD_QUERY_AGENT_RUNTIME_ID=okf-query-agent-prod
PROD_MIN_INSTANCES=1
PROD_MAX_INSTANCES=10
