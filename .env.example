PROD_QUERY_WEB_SERVICE_ACCOUNT=

# Description: Optional Production ingress override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_INGRESS` -> `PROD_CLOUD_RUN_INGRESS` -> `CLOUD_RUN_INGRESS`)
# Choices: Leave blank | all | internal-and-cloud-load-balancing | internal
PROD_QUERY_WEB_INGRESS=

# Description: Optional Production security mode override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_SECURITY_MODE` -> `PROD_CLOUD_RUN_SECURITY_MODE` -> `CLOUD_RUN_SECURITY_MODE`)
# Choices: Leave blank | iap | iam | unauthenticated
PROD_QUERY_WEB_SECURITY_MODE=

# Description: Optional Production VPC mode override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_VPC_MODE` -> `PROD_CLOUD_RUN_VPC_MODE` -> `CLOUD_RUN_VPC_MODE`)
# Choices: Leave blank | direct | connector | none
PROD_QUERY_WEB_VPC_MODE=

# Description: Optional Production VPC egress override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_VPC_EGRESS` -> `PROD_CLOUD_RUN_VPC_EGRESS` -> `CLOUD_RUN_VPC_EGRESS`)
# Choices: Leave blank | all-traffic | private-ranges-only
PROD_QUERY_WEB_VPC_EGRESS=

# Description: Optional Production Direct VPC network override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_VPC_NETWORK` -> `PROD_CLOUD_RUN_VPC_NETWORK` -> `CLOUD_RUN_VPC_NETWORK`)
# Choices: Leave blank, or set a valid VPC network name.
PROD_QUERY_WEB_VPC_NETWORK=

# Description: Optional Production Direct VPC subnetwork override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_VPC_SUBNET` -> `PROD_CLOUD_RUN_VPC_SUBNET` -> `CLOUD_RUN_VPC_SUBNET`)
# Choices: Leave blank, or set a valid regional VPC subnetwork name.
PROD_QUERY_WEB_VPC_SUBNET=

# Description: Optional Production Serverless VPC Connector override specifically for Web App 2 (`okf-query-agent-web-prod`).
# Default: "" (empty; inherits `QUERY_WEB_VPC_CONNECTOR` -> `PROD_CLOUD_RUN_VPC_CONNECTOR` -> `CLOUD_RUN_VPC_CONNECTOR`)
# Choices: Leave blank, or set connector name / full URI.
PROD_QUERY_WEB_VPC_CONNECTOR=

# ------------------------------------------------------------------------------
# 10. Unified Workbench v2, Selectable Gemini 4 Models, Pipeline Job & Spanner Native Embeddings
# ------------------------------------------------------------------------------

# Description: Default selectable Gemini 4 model for Extractor Studio & batch document extraction.
# Default: gemini-4-carbon
# Choices: gemini-4-carbon (default) | gemini-4-hydrogen | gemini-4-argon | gemini-4-neon
EXTRACTER_DEFAULT_MODEL=gemini-4-carbon

# Description: Default selectable Gemini 4 model for Knowledge Graph & Query Workbench.
# Default: gemini-4-hydrogen
# Choices: gemini-4-hydrogen (default) | gemini-4-carbon | gemini-4-argon | gemini-4-neon
QUERY_DEFAULT_MODEL=gemini-4-hydrogen

# Description: Comma-separated strict allowlist of Gemini 4 models exposed in the Unified UI model selector.
# Default: gemini-4-carbon,gemini-4-hydrogen,gemini-4-argon,gemini-4-neon
# Choices: Subset of gemini-4-carbon,gemini-4-hydrogen,gemini-4-argon,gemini-4-neon.
ALLOWED_GEMINI_MODELS=gemini-4-carbon,gemini-4-hydrogen,gemini-4-argon,gemini-4-neon

# Description: Shared default Cloud Run service name for the Unified OKF Engineering Workbench v2.
# Default: okf-engineering-workbench
# Choices: Valid Cloud Run service name (lowercase letters, digits, hyphens).
UNIFIED_WEB_SERVICE_NAME=okf-engineering-workbench

# Description: Non-Production Cloud Run service name for Unified OKF Engineering Workbench v2.
# Default: okf-engineering-workbench
# Choices: Valid Cloud Run service name.
NONPROD_UNIFIED_WEB_SERVICE_NAME=okf-engineering-workbench

# Description: Production Cloud Run service name for Unified OKF Engineering Workbench v2.
# Default: okf-engineering-workbench-prod
# Choices: Valid Cloud Run service name.
PROD_UNIFIED_WEB_SERVICE_NAME=okf-engineering-workbench-prod

# Description: Shared default Cloud Run Job name for parameterized batch extraction & Spanner sync.
# Default: okf-pipeline-job
# Choices: Valid Cloud Run Job name (lowercase letters, digits, hyphens).
PIPELINE_JOB_NAME=okf-pipeline-job

# Description: Non-Production Cloud Run Job name for parameterized batch extraction & Spanner sync.
# Default: okf-pipeline-job
# Choices: Valid Cloud Run Job name.
NONPROD_PIPELINE_JOB_NAME=okf-pipeline-job

# Description: Production Cloud Run Job name for parameterized batch extraction & Spanner sync.
# Default: okf-pipeline-job-prod
# Choices: Valid Cloud Run Job name.
PROD_PIPELINE_JOB_NAME=okf-pipeline-job-prod

# Description: Task timeout in seconds for the parameterized Cloud Run Pipeline Job (`okf-pipeline-job`).
# Default: 3600
# Choices: Integer seconds 60..86400 (default 3600 = 1 hour).
PIPELINE_JOB_TIMEOUT=3600

# Description: Execution backend mode for `/api/jobs/run` dispatcher (`auto` uses Cloud Run Jobs API on Cloud Run and local subprocess offline).
# Default: auto
# Choices: auto | cloud_run_job | local
CLOUD_RUN_JOBS_EXECUTION_MODE=auto

# Description: Spanner embedding generation mode during ingestion & query (`native_ml_predict` uses Spanner CREATE MODEL + ML.PREDICT).
# Default: native_ml_predict
# Choices: native_ml_predict (recommended) | client_sdk
SPANNER_NATIVE_EMBEDDING_MODE=native_ml_predict

# Description: Vertex AI regional endpoint location for Spanner native remote embedding model (`OkfTextEmbeddingModel`).
# Default: asia-southeast1
# Choices: Valid regional Vertex AI location supporting text-embedding-005 (e.g., asia-southeast1 | us-central1).
SPANNER_EMBEDDING_LOCATION=asia-southeast1

# Description: Enforce cryptographic verification of `x-goog-iap-jwt-assertion` header in FastAPI middleware (Rule 10 Pattern 1B).
# Default: false
# Choices: true (required in Cloud Run IAP production) | false (local development only)
IAP_JWT_ENFORCEMENT=false

# Description: Expected Google Cloud IAP JWT audience (`/projects/<PROJECT_NUMBER>/global/backendServices/<ID>` or Cloud Run IAP audience).
# Default: "" (empty; set for strict audience enforcement in production)
# Choices: Leave blank locally, or set exact IAP JWT audience string.
IAP_JWT_AUDIENCE=

# Description: Maximum ADK tool calls allowed per agent turn to prevent runaway loops (SAIF DMS execution budget).
# Default: 12
# Choices: Positive integer (recommended 8..20).
MAX_AGENT_TOOL_CALLS=12

# Description: Artifact Registry Docker repository ID storing the unified container image.
# Default: okf-workbench
# Choices: Valid Artifact Registry repository ID.
ARTIFACT_REGISTRY_REPO=okf-workbench
