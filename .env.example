NONPROD_CLOUD_RUN_VPC_CONNECTOR=
# Description: Optional vCPU override for `both Production Cloud Run web apps` (`--cpu`).
# Default: "" (empty; inherits `CLOUD_RUN_` CPU)
# Choices: Leave blank | 1 | 2 | 4 | 6 | 8
PROD_CLOUD_RUN_CPU=

# Description: Optional memory limit override for `both Production Cloud Run web apps` (`--memory`).
# Default: "" (empty; inherits `CLOUD_RUN_` MEMORY)
# Choices: Leave blank | 2Gi | 4Gi | 8Gi | 16Gi | 32Gi
PROD_CLOUD_RUN_MEMORY=

# Description: Optional maximum request concurrency override for `both Production Cloud Run web apps` (`--concurrency`).
# Default: "" (empty; inherits `CLOUD_RUN_` CONCURRENCY)
