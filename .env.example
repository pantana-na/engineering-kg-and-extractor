# ------------------------------------------------------------------------------
# 5. Knowledge Storage (GCS), Cloud Spanner, Dataplex & Local Paths
# ------------------------------------------------------------------------------

# Description: Primary Google Cloud Storage bucket name (without `gs://`) storing raw PDFs, vision cache, and OKF `.md` bundles.
# Default: your-gcp-project-id-okf-knowledge
# Choices: Valid globally unique GCS bucket name string.
DESTINATION_GCS_BUCKET=your-gcp-project-id-okf-knowledge

# Description: GCS object prefix under `DESTINATION_GCS_BUCKET` where extracted OKF v0.2 `.md` bundles are published.
# Default: okf-bundles/chemical-plant
# Choices: Valid relative GCS folder prefix without leading/trailing slashes (e.g., okf-bundles/chemical-plant).
DESTINATION_GCS_PREFIX=okf-bundles/chemical-plant

# Description: GCS object prefix under `DESTINATION_GCS_BUCKET` hosting immutable source engineering PDFs.
# Default: reference/raw
# Choices: Valid relative GCS folder prefix containing `data_sheets/`, `pid/`, `pfd/`, `operating_manuals/`, `standards/`.
SOURCE_GCS_RAW_PREFIX=reference/raw

# Description: Local filesystem directory where `extracter_agent` writes and stages OKF v0.2 `.md` bundle files.
# Default: build/okf_bundle
# Choices: Relative or absolute directory path (automatically mapped to `/tmp/okf_bundle` inside cloud runtimes).
OUTPUT_BUNDLE_DIR=build/okf_bundle

# Description: Cloud Spanner instance ID hosting the OKF Property Graph, Vector Search, and Full-Text Search store.
# Default: okf-knowledge-spanner
# Choices: Valid Cloud Spanner instance ID (lowercase letters, digits, hyphens; 2–64 chars).
SPANNER_INSTANCE_ID=okf-knowledge-spanner

# Description: Cloud Spanner database ID inside `SPANNER_INSTANCE_ID` created from `query_agent/spanner/schema.sql`.
# Default: okf_knowledge_graph
# Choices: Valid Cloud Spanner database ID (lowercase letters, digits, underscores, hyphens; 2–30 chars).
SPANNER_DATABASE_ID=okf_knowledge_graph

# Description: Compute capacity allocated to the Cloud Spanner instance in granular Processing Units (1000 PU = 1 Node).
# Default: 100
# Choices: 100 | 200 | 300 | ... | 900 (multiples of 100), or multiples of 1000 for full nodes.
SPANNER_PROCESSING_UNITS=100

# Description: Vertex AI text embedding model used to generate 768-dimensional vectors for Cloud Spanner RRF hybrid search.
# Default: text-embedding-005
# Choices: text-embedding-005 | gemini-embedding-001 (must match 768-d schema column vector length).
EMBEDDING_MODEL=text-embedding-005

# Description: Google Cloud Dataplex Universal Catalog Entry Group ID used when syncing OKF governance metadata.
# Default: okf_knowledge_assets
# Choices: Valid Dataplex Entry Group ID (lowercase letters, digits, underscores, hyphens).
DATAPLEX_ENTRY_GROUP_ID=okf_knowledge_assets

# Description: Google Cloud Dataplex Aspect Type / Tag Template ID storing OKF trust tier, approver, and lineage metadata.
# Default: okf_governance_template
# Choices: Valid Dataplex Aspect/Tag Template ID (lowercase letters, digits, underscores, hyphens).
DATAPLEX_TAG_TEMPLATE_ID=okf_governance_template

# Description: Local read-only directory containing source engineering PDFs (`data_sheets`, `pid`, `pfd`, `operating_manuals`, `standards`).
# Default: reference/raw
# Choices: Valid relative or absolute local directory path.
REFERENCE_RAW_DIR=reference/raw

# Description: Local read-only directory containing reference wiki ground-truth markdown fixtures for evaluation benchmarks.
# Default: reference/wiki
# Choices: Valid relative or absolute local directory path.
REFERENCE_WIKI_DIR=reference/wiki

# ------------------------------------------------------------------------------
# 6. Non-Production Environment Configuration (`NONPROD_*`)
# Used when running `./deploy.sh --env nonprod` (default on `main` / `develop`).
# ------------------------------------------------------------------------------

# Description: Logical environment label applied to Non-Production deployments and telemetry.
# Default: nonprod
# Choices: nonprod | dev | development
NONPROD_ENVIRONMENT_NAME=nonprod

# Description: Target GCP Project ID for Non-Production deployments.
# Default: your-gcp-project-id
# Choices: Valid GCP project ID string (inherits `GOOGLE_CLOUD_PROJECT` if left blank).
NONPROD_PROJECT_ID=your-gcp-project-id

# Description: Target GCP Region for Non-Production Agent Runtimes and Cloud Run services.
# Default: asia-southeast1
# Choices: Valid GCP region (e.g., asia-southeast1 | us-central1 | europe-west1).
NONPROD_REGION=asia-southeast1

# Description: Non-Production GCS bucket name for environment-isolated OKF bundle artifacts.
# Default: your-gcp-project-id-okf-knowledge-nonprod
# Choices: Valid GCS bucket name string.
NONPROD_GCS_BUCKET=your-gcp-project-id-okf-knowledge-nonprod

# Description: Deployed Vertex AI Reasoning Engine resource name or numeric ID for Agent 1 (`extracter_agent`) in Non-Prod.
# Default: extracter-agent-nonprod
# Choices: Full resource URI (`projects/<NUM>/locations/<REGION>/reasoningEngines/<ID>`), numeric `<ID>`, or display name prior to first deploy.
NONPROD_AGENT_RUNTIME_ID=extracter-agent-nonprod

# Description: Deployed Vertex AI Reasoning Engine resource name or numeric ID for Agent 2 (`query_agent`) in Non-Prod.
# Default: okf-query-agent-nonprod
# Choices: Full resource URI (`projects/<NUM>/locations/<REGION>/reasoningEngines/<ID>`), numeric `<ID>`, or display name prior to first deploy.
NONPROD_QUERY_AGENT_RUNTIME_ID=okf-query-agent-nonprod

# Description: Non-Production Cloud Run service name for Web App 1 (OKF Extraction Workbench).
# Default: extracter-agent-web
# Choices: Valid Cloud Run service name (lowercase letters, digits, hyphens; <= 49 chars).
CLOUD_RUN_WEB_SERVICE=extracter-agent-web

# Description: Deployed HTTPS URL for Non-Production Web App 1 (`extracter-agent-web`), used by smoke tests and CLI callers.
# Default: https://extracter-agent-web-nonprod.a.run.app
# Choices: Valid `https://*.run.app` or custom domain URL.
CLOUD_RUN_WEB_URL=https://extracter-agent-web-nonprod.a.run.app

# Description: Non-Production Cloud Run service name for Web App 2 (OKF Spanner Retrieval Workbench).
# Default: okf-query-agent-web
# Choices: Valid Cloud Run service name (lowercase letters, digits, hyphens; <= 49 chars).
QUERY_WEB_SERVICE_NAME=okf-query-agent-web

# Description: Deployed HTTPS URL for Non-Production Web App 2 (`okf-query-agent-web`), used by smoke tests and CLI callers.
# Default: https://okf-query-agent-web-nonprod.a.run.app
# Choices: Valid `https://*.run.app` or custom domain URL.
QUERY_WEB_SERVICE_URL=https://okf-query-agent-web-nonprod.a.run.app

# Description: Minimum warm container instances kept running per Cloud Run web service in Non-Production.
# Default: 0
# Choices: Integer >= 0 (0 enables scale-to-zero when idle; 1+ keeps warm instances ready).
NONPROD_MIN_INSTANCES=0

# Description: Maximum autoscaling container instances per Cloud Run web service in Non-Production.
# Default: 3
# Choices: Integer >= 1 (must be >= `NONPROD_MIN_INSTANCES`, e.g., 1..100).
NONPROD_MAX_INSTANCES=3

