# ==============================================================================
# Extracter Agent & Spanner Query Agent Unified Configuration Template
# Target Project: your-gcp-project-id
# Repository: https://github.com/pantana-na/engineering-kg-and-extractor.git
# Rule 8 Compliance: Single Unified Environment Parameter Management
# Every parameter below documents: Description, Default, and Choices.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Shared / Core Platform & Gemini Model Configuration
# ------------------------------------------------------------------------------

# Description: Display/service identifier for Agent 1 (OKF Extracter Agent) on Vertex AI Agent Runtime.
# Default: extracter-agent
# Choices: Valid GCP resource identifier string (lowercase letters, digits, hyphens; e.g., extracter-agent).
SERVICE_NAME=extracter-agent

# Description: Display/service identifier for Agent 2 (OKF Spanner Graph-RAG Query Agent) on Vertex AI Agent Runtime.
# Default: okf-query-agent
# Choices: Valid GCP resource identifier string (lowercase letters, digits, hyphens; e.g., okf-query-agent).
QUERY_SERVICE_NAME=okf-query-agent

# Description: Canonical GitHub repository URL used for CI/CD provenance and build tracking.
# Default: https://github.com/pantana-na/engineering-kg-and-extractor.git
# Choices: Valid HTTPS or SSH Git repository URL.
GIT_REPO_URL=https://github.com/pantana-na/engineering-kg-and-extractor.git

# Description: Shared default Google Cloud Project ID hosting Vertex AI, Cloud Run, GCS, Spanner, and Dataplex.
# Default: your-gcp-project-id
# Choices: Any valid GCP project ID string (e.g., my-gcp-project-123).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Description: Numeric Google Cloud Project Number used to construct default Compute Engine and IAP service agent emails.
# Default: 000000000000
# Choices: 12-digit numeric GCP project number (from `gcloud projects describe <PROJECT_ID> --format='value(projectNumber)'`).
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000

# Description: Primary regional location for Cloud Run, Vertex AI Agent Runtime, Cloud Spanner, GCS, and Dataplex.
# Default: asia-southeast1
# Choices: Valid GCP region supporting Vertex AI Agent Engine & Cloud Spanner (e.g., asia-southeast1 | us-central1 | europe-west1).
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Description: Vertex AI endpoint location used when invoking Gemini foundation models (`google-genai` SDK).
# Default: global
# Choices: global (recommended for Gemini 4 Argon) | us-central1 | asia-southeast1 | any supported Vertex AI Gemini region.
GEMINI_LOCATION=global

# Description: Enables native Vertex AI authentication (ADC) instead of consumer Gemini Developer API keys.
# Default: true
# Choices: true | false
GOOGLE_GENAI_USE_VERTEXAI=true

# Description: Foundation Gemini model used across 300-DPI multimodal PDF OCR, Extracter Agent, and Spanner Query Agent.
# Default: gemini-4-argon
# Choices: gemini-4-argon (recommended) | gemini-2.5-pro | gemini-2.5-flash | any Vertex AI supported Gemini model ID.
GEMINI_MODEL=gemini-4-argon

# Description: Default deployment target mode when running unified deployment tooling.
# Default: agent_runtime
# Choices: agent_runtime | cloud_run | query_agent | query_web | infra | all
DEPLOYMENT_TARGET=agent_runtime

# ------------------------------------------------------------------------------
# 2. Cloud Build Service Account (Shared Default)
# ------------------------------------------------------------------------------

# Description: IAM Service Account used by Google Cloud Build when building container images (`--build-service-account`).
# Default: 000000000000-compute@developer.gserviceaccount.com (project default Compute Engine service account)
# Choices: Service account email (`<SA>@<PROJECT>.iam.gserviceaccount.com` or `<NUM>-compute@developer.gserviceaccount.com`) or full URI (`projects/<PROJECT_ID>/serviceAccounts/<EMAIL>`).
CLOUDBUILD_SERVICE_ACCOUNT=000000000000-compute@developer.gserviceaccount.com

# ------------------------------------------------------------------------------
# 3. Cloud Run Shared Defaults (Runtime SA, Networking, Native IAP & VPC Egress)
# Precedence: {ENV}_{APP}_{PARAM} -> {APP}_{PARAM} -> {ENV}_CLOUD_RUN_{PARAM} -> CLOUD_RUN_{PARAM}
# Applies to both Web App 1 (extracter-agent-web) and Web App 2 (okf-query-agent-web).
# ------------------------------------------------------------------------------

# Description: Shared default IAM runtime Service Account attached to both Cloud Run web services (`--service-account`).
# Default: 000000000000-compute@developer.gserviceaccount.com (project default Compute Engine service account)
# Choices: Service account email (`<SA>@<PROJECT>.iam.gserviceaccount.com` or `<NUM>-compute@developer.gserviceaccount.com`) or full URI (`projects/<PROJECT_ID>/serviceAccounts/<EMAIL>`).
CLOUD_RUN_SERVICE_ACCOUNT=000000000000-compute@developer.gserviceaccount.com

# Description: Shared default network ingress restriction for both Cloud Run web services (`--ingress`).
# Default: all
# Choices: all ("All") | internal-and-cloud-load-balancing ("internal + external loadbalancer") | internal ("Internal only")
CLOUD_RUN_INGRESS=all

# Description: Shared default authentication & Cloud Run Native IAP security mode for both Cloud Run web services.
# Default: iap
# Choices: iap ("require authentication (IAM + IAP)" via `--iap --invoker-iam-check`) | iam (IAM-only `--invoker-iam-check --no-iap`) | unauthenticated (`--no-invoker-iam-check --no-iap`, zero allUsers)
CLOUD_RUN_SECURITY_MODE=iap

# Description: Shared default outbound VPC connectivity mechanism for both Cloud Run web services.
# Default: direct
# Choices: direct ("sending all traffic to the VPC directly" via Direct VPC Egress) | connector ("serverless vpc access connectors") | none (disable VPC egress)
CLOUD_RUN_VPC_MODE=direct

# Description: Shared default outbound traffic routing scope when VPC egress (`direct` or `connector`) is enabled.
# Default: all-traffic
# Choices: all-traffic | private-ranges-only
CLOUD_RUN_VPC_EGRESS=all-traffic

# Description: Shared default VPC network name used when `CLOUD_RUN_VPC_MODE=direct`.
# Default: default
# Choices: Valid VPC network name or URI in the target project/Shared VPC (e.g., default | vpc-network-1).
CLOUD_RUN_VPC_NETWORK=default

# Description: Shared default regional VPC subnetwork name used when `CLOUD_RUN_VPC_MODE=direct`.
# Default: default
# Choices: Valid subnetwork name in `GOOGLE_CLOUD_LOCATION` with sufficient `/26`+ IP range (e.g., default | ap-southeast-1-subnet1).
CLOUD_RUN_VPC_SUBNET=default

# Description: Shared default Serverless VPC Access Connector ID used only when `CLOUD_RUN_VPC_MODE=connector`.
# Default: "" (empty; not required when `CLOUD_RUN_VPC_MODE=direct`)
# Choices: Leave blank when `VPC_MODE=direct|none`, or set connector name / full URI (`projects/<PROJECT>/locations/<REGION>/connectors/<NAME>`).
CLOUD_RUN_VPC_CONNECTOR=
# Description: Shared default vCPU allocation per Cloud Run container instance (`--cpu`).
# Default: 4
# Choices: 1 | 2 | 4 | 6 | 8
CLOUD_RUN_CPU=4

# Description: Shared default memory limit per Cloud Run container instance (`--memory`).
# Default: 8Gi
# Choices: Kubernetes memory quantity between 512Mi and 32Gi compatible with CPU tier (e.g., 2Gi | 4Gi | 8Gi | 16Gi).
CLOUD_RUN_MEMORY=8Gi

# Description: Shared default maximum concurrent HTTP/SSE requests per Cloud Run container instance (`--concurrency`).
# Default: 30
# Choices: Integer 1..1000 (30 recommended for streaming SSE + multimodal workbench workloads).
CLOUD_RUN_CONCURRENCY=30

# Description: Shared default HTTP/SSE request timeout in seconds per Cloud Run service (`--timeout`).
# Default: 900
# Choices: Integer seconds 1..3600 (900 = 15 minutes for long-running Agent Runtime streaming turns).
CLOUD_RUN_TIMEOUT=900

# Description: Shared fallback minimum warm container instances per Cloud Run service when tier-specific min is unset.
# Default: 0
# Choices: Integer >= 0 (0 enables scale-to-zero when idle; 1+ keeps warm instances ready).
CLOUD_RUN_MIN_INSTANCES=0

# Description: Shared fallback maximum autoscaling container instances per Cloud Run service when tier-specific max is unset.
# Default: 3
# Choices: Integer >= 1 (must be >= `CLOUD_RUN_MIN_INSTANCES`, e.g., 3 in Non-Prod, 5 in Prod).
CLOUD_RUN_MAX_INSTANCES=3

# ------------------------------------------------------------------------------
# 4. Optional App-Level Shared Overrides (Leave Blank to Inherit CLOUD_RUN_*)
# ------------------------------------------------------------------------------

# --- Web App 1: OKF Extraction Workbench (`extracter-agent-web`) ---

# Description: Optional runtime Service Account override for `extracter-agent-web` across environments.
# Default: "" (empty; inherits `CLOUD_RUN_SERVICE_ACCOUNT`)
# Choices: Leave blank, or set a valid GCP service account email / `projects/<PROJECT>/serviceAccounts/<EMAIL>` URI.
EXTRACTER_WEB_SERVICE_ACCOUNT=

# Description: Optional network ingress override for `extracter-agent-web` across environments.
# Default: "" (empty; inherits `CLOUD_RUN_INGRESS`)
# Choices: Leave blank | all | internal-and-cloud-load-balancing ("internal + external loadbalancer") | internal
EXTRACTER_WEB_INGRESS=

# Description: Optional authentication & IAP security mode override for `extracter-agent-web` across environments.
# Default: "" (empty; inherits `CLOUD_RUN_SECURITY_MODE`)
# Choices: Leave blank | iap | iam | unauthenticated
EXTRACTER_WEB_SECURITY_MODE=

# Description: Optional VPC connectivity mode override for `extracter-agent-web` across environments.
# Default: "" (empty; inherits `CLOUD_RUN_VPC_MODE`)
# Choices: Leave blank | direct | connector | none
EXTRACTER_WEB_VPC_MODE=

# Description: Optional VPC egress routing override for `extracter-agent-web` across environments.
# Default: "" (empty; inherits `CLOUD_RUN_VPC_EGRESS`)
# Choices: Leave blank | all-traffic | private-ranges-only
EXTRACTER_WEB_VPC_EGRESS=

# Description: Optional Direct VPC network name override for `extracter-agent-web` when `VPC_MODE=direct`.
# Default: "" (empty; inherits `CLOUD_RUN_VPC_NETWORK`)
# Choices: Leave blank, or set a valid VPC network name.
EXTRACTER_WEB_VPC_NETWORK=

# Description: Optional Direct VPC subnetwork name override for `extracter-agent-web` when `VPC_MODE=direct`.
# Default: "" (empty; inherits `CLOUD_RUN_VPC_SUBNET`)
# Choices: Leave blank, or set a valid regional VPC subnetwork name.
EXTRACTER_WEB_VPC_SUBNET=

# Description: Optional Serverless VPC Access Connector override for `extracter-agent-web` when `VPC_MODE=connector`.
# Default: "" (empty; inherits `CLOUD_RUN_VPC_CONNECTOR`)
# Choices: Leave blank, or set connector name / full `projects/<PROJECT>/locations/<REGION>/connectors/<NAME>` URI.
EXTRACTER_WEB_VPC_CONNECTOR=
# Description: Optional vCPU override for `extracter-agent-web` (`--cpu`).
# Default: "" (empty; inherits `CLOUD_RUN_` CPU)
# Choices: Leave blank | 1 | 2 | 4 | 6 | 8
EXTRACTER_WEB_CPU=

# Description: Optional memory limit override for `extracter-agent-web` (`--memory`).
# Default: "" (empty; inherits `CLOUD_RUN_` MEMORY)
# Choices: Leave blank | 2Gi | 4Gi | 8Gi | 16Gi | 32Gi
EXTRACTER_WEB_MEMORY=

# Description: Optional maximum request concurrency override for `extracter-agent-web` (`--concurrency`).
# Default: "" (empty; inherits `CLOUD_RUN_` CONCURRENCY)
# Choices: Leave blank | integer 1..1000
EXTRACTER_WEB_CONCURRENCY=

# Description: Optional request timeout (seconds) override for `extracter-agent-web` (`--timeout`).
# Default: "" (empty; inherits `CLOUD_RUN_` TIMEOUT)
# Choices: Leave blank | integer 1..3600
EXTRACTER_WEB_TIMEOUT=

# Description: Optional minimum warm container instances override for `extracter-agent-web` (`--min-instances`).
# Default: "" (empty; inherits `CLOUD_RUN_` MIN_INSTANCES)
# Choices: Leave blank | integer >= 0
EXTRACTER_WEB_MIN_INSTANCES=

# Description: Optional maximum autoscaling container instances override for `extracter-agent-web` (`--max-instances`).
# Default: "" (empty; inherits `CLOUD_RUN_` MAX_INSTANCES)
# Choices: Leave blank | integer >= 1
EXTRACTER_WEB_MAX_INSTANCES=

