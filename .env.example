# ------------------------------------------------------------------------------
# 7. Production Environment Configuration (`PROD_*`)
# Used when running `./deploy.sh --env prod` (promoted via PR to `prod` branch).
# ------------------------------------------------------------------------------

# Description: Logical environment label applied to Production deployments and telemetry.
# Default: prod
# Choices: prod | production | release
PROD_ENVIRONMENT_NAME=prod

# Description: Target GCP Project ID for Production deployments.
# Default: your-gcp-project-id
# Choices: Valid GCP project ID string (inherits `GOOGLE_CLOUD_PROJECT` if left blank).
PROD_PROJECT_ID=your-gcp-project-id

# Description: Target GCP Region for Production Agent Runtimes and Cloud Run services.
# Default: asia-southeast1
# Choices: Valid GCP region (e.g., asia-southeast1 | us-central1 | europe-west1).
PROD_REGION=asia-southeast1

# Description: Production GCS bucket name for environment-isolated OKF bundle artifacts.
# Default: your-gcp-project-id-okf-knowledge-prod
# Choices: Valid GCS bucket name string.
PROD_GCS_BUCKET=your-gcp-project-id-okf-knowledge-prod

# Description: Deployed Vertex AI Reasoning Engine resource name or numeric ID for Agent 1 (`extracter_agent`) in Production.
# Default: extracter-agent-prod
# Choices: Full resource URI (`projects/<NUM>/locations/<REGION>/reasoningEngines/<ID>`), numeric `<ID>`, or display name prior to first deploy.
PROD_AGENT_RUNTIME_ID=extracter-agent-prod

# Description: Deployed Vertex AI Reasoning Engine resource name or numeric ID for Agent 2 (`query_agent`) in Production.
# Default: okf-query-agent-prod
# Choices: Full resource URI (`projects/<NUM>/locations/<REGION>/reasoningEngines/<ID>`), numeric `<ID>`, or display name prior to first deploy.
PROD_QUERY_AGENT_RUNTIME_ID=okf-query-agent-prod

# Description: Production Cloud Run service name for Web App 1 (OKF Extraction Workbench).
# Default: extracter-agent-web-prod
# Choices: Valid Cloud Run service name (lowercase letters, digits, hyphens; <= 49 chars).
PROD_CLOUD_RUN_WEB_SERVICE=extracter-agent-web-prod

# Description: Production Cloud Run service name for Web App 2 (OKF Spanner Retrieval Workbench).
# Default: okf-query-agent-web-prod
# Choices: Valid Cloud Run service name (lowercase letters, digits, hyphens; <= 49 chars).
PROD_QUERY_WEB_SERVICE_NAME=okf-query-agent-web-prod

# Description: Minimum warm container instances kept running per Cloud Run web service in Production.
# Default: 0
# Choices: Integer >= 0 (0 enables scale-to-zero when idle; 1+ keeps warm instances ready).
PROD_MIN_INSTANCES=0

# Description: Maximum autoscaling container instances per Cloud Run web service in Production.
# Default: 5
# Choices: Integer >= 1 (must be >= `PROD_MIN_INSTANCES`, e.g., 1..100).
PROD_MAX_INSTANCES=5

